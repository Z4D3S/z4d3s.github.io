---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '@/config/theme';

export async function getStaticPaths() {
  return categories.map(cat => ({ params: { category: cat.id } }));
}

const { category } = Astro.params;

const posts = (await getCollection('blog'))
  .filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'))
  .filter(post => post.data.category === category && post.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryData = categories.find(c => c.id === category);
---

<BaseLayout title={`${categoryData?.label || category} - NightOps`} description={`Posts in ${categoryData?.label}`}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="flex items-center gap-3 mb-8">
      <a href="/" class="text-gray-500 hover:text-cyber-accent transition-colors">
        <Icon name="arrow-left" class="w-5 h-5" />
      </a>
      <h1 class="cyber-heading mb-0 flex items-center gap-3">
        <Icon name={categoryData?.icon || 'folder'} class="w-6 h-6 text-cyber-accent" />
        {categoryData?.label}
      </h1>
    </div>
    
    <div class="grid md:grid-cols-2 gap-6">
      {posts.map(post => (
        <PostCard 
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          href={`/blog/${post.slug}`}
          tags={post.data.tags}
        />
      ))}
    </div>
    
    {posts.length === 0 && (
      <p class="text-gray-400 text-center py-8">No articles in this category yet.</p>
    )}
  </section>
</BaseLayout>
