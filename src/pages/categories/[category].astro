---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { getCollection } from 'astro:content';
import { categories } from '@/config/theme';

export async function getStaticPaths() {
  return categories.map(cat => ({ params: { category: cat.id } }));
}

const { category } = Astro.params;

const posts = (await getCollection('blog'))
  .filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'))
  .filter(post => post.data.category === category && post.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryData = categories.find(c => c.id === category);
---

<BaseLayout title={`${categoryData?.label || category} - z4des`} description={`Artículos en ${categoryData?.label}`}>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <a href="/blog" class="text-sm text-muted transition-colors hover:text-ink">
      &larr; Artículos
    </a>

    <header class="mb-10 mt-6">
      <p class="font-mono text-xs text-muted"><span class="text-accent">$</span> ls ~/categorías</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink">{categoryData?.label || category}</h1>
      {categoryData?.desc && <p class="mt-2 text-muted">{categoryData.desc}</p>}
    </header>

    <ArticleList posts={posts} />

    {posts.length === 0 && (
      <p class="text-muted">Aún no hay artículos.</p>
    )}
  </section>
</BaseLayout>
