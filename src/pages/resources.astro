---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { siteConfig } from '@/config/theme';

const resources = [
  { 
    name: 'MITRE ATT&CK', 
    url: 'https://attack.mitre.org',
    desc: 'Framework de tácticas y técnicas de atacantes'
  },
  { 
    name: 'Virustotal', 
    url: 'https://www.virustotal.com',
    desc: 'Analizar archivos y URLs sospechosas'
  },
  { 
    name: 'AlienVault OTX', 
    url: 'https://otx.alienvault.com',
    desc: 'Inteligencia de amenazas crowdsourced'
  },
  { 
    name: 'AbuseIPDB', 
    url: 'https://www.abuseipdb.com',
    desc: 'Verificar IPs maliciosas'
  },
  { 
    name: 'URLScan', 
    url: 'https://urlscan.io',
    desc: 'Analizar y sandbox de URLs'
  },
  { 
    name: 'Hybrid Analysis', 
    url: 'https://www.hybrid-analysis.com',
    desc: 'Análisis de malware automatizado'
  },
  { 
    name: 'CVE Database', 
    url: 'https://cve.mitre.org',
    desc: 'Base de datos de vulnerabilidades'
  },
  { 
    name: 'Shodan', 
    url: 'https://www.shodan.io',
    desc: 'Buscador de dispositivos conectados'
  },
  { 
    name: 'GreyNoise', 
    url: 'https://www.greynoise.io',
    desc: 'Analizar tráfico malicioso'
  },
  { 
    name: 'ThreatFox', 
    url: 'https://threatfox.abuse.ch',
    desc: 'Indicadores de malware recientes'
  },
];
---

<BaseLayout title="Resources - NightOps" description="Recursos para análisis de seguridad">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="flex items-center gap-3 mb-8">
      <h1 class="cyber-heading mb-0 flex items-center gap-3">
        <Icon name="external-link" class="w-6 h-6 text-cyber-accent" />
        Resources
      </h1>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      {resources.map(res => (
        <a 
          href={res.url} 
          target="_blank" 
          rel="noopener"
          class="cyber-card group hover:border-cyber-accent transition-colors"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white group-hover:text-cyber-accent transition-colors">{res.name}</span>
            <Icon name="external-link" class="w-4 h-4 text-gray-500" />
          </div>
          <p class="text-sm text-gray-500">{res.desc}</p>
        </a>
      ))}
    </div>

  </section>
</BaseLayout>
