---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/theme';
import { isVisiblePost, isChallenge, sortByDateDesc } from '@/utils/blog';

const allPosts = (await getCollection('blog')).filter(isVisiblePost).sort(sortByDateDesc);
const posts = allPosts.filter(post => !isChallenge(post));
const challenges = allPosts.filter(isChallenge);
const events = [...new Set(challenges.map(post => post.data.event as string))];

const latest = posts.slice(0, 15);
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <header class="mb-12">
      <h1 class="text-6xl font-semibold leading-none tracking-tight text-ink">{siteConfig.title}</h1>
      <p class="mt-4 font-mono text-sm text-muted">ciberseguridad / red team / investigación</p>
    </header>

    <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-muted">
      <span class="text-accent">/</span> artículos
    </h2>
    <ArticleList posts={latest} />

    <div class="mt-10">
      <a href="/blog" class="font-mono text-xs text-ink underline decoration-muted/40 underline-offset-4 hover:decoration-accent">
        ls -la ~/artículos &rarr;
      </a>
    </div>

    {challenges.length > 0 && (
      <div class="mt-14 border-t border-line pt-8">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted">
          <span class="text-accent">/</span> retos
        </h2>
        <p class="mt-2 text-sm text-muted">Retos CTF, separados de los artículos.</p>
        <a href="/challenges" class="mt-4 inline-block font-mono text-xs text-ink underline decoration-muted/40 underline-offset-4 hover:decoration-accent">
          Retos de {events.join(', ')} &rarr;
        </a>
      </div>
    )}
  </section>
</BaseLayout>
