---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Buscar - z4des" description="Buscar artículos">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <header>
      <p class="font-mono text-xs text-muted"><span class="text-accent">$</span> grep -ri</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink">Buscar</h1>
      <p class="mt-2 text-muted">Busca artículos por título, descripción o etiqueta.</p>
    </header>

    <input
      id="search-input"
      type="search"
      placeholder="Buscar artículos..."
      autocomplete="off"
      class="mt-8 w-full border-b border-line bg-transparent py-3 text-lg text-ink placeholder-muted/60 focus:border-ink focus:outline-none"
    />

    <p id="search-hint" class="mt-6 text-sm text-muted">Escribe al menos 2 caracteres.</p>
    <div id="search-results" class="mt-2 divide-y divide-line"></div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const hint = document.getElementById('search-hint');

  type Post = {
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: string;
      tags: string[];
    };
  };

  let posts: Post[] = [];

  fetch('/search.json')
    .then(response => response.json())
    .then((data: Post[]) => {
      posts = data;
    })
    .catch(() => {});

  function makeRow(post: Post) {
    const link = document.createElement('a');
    link.href = `/blog/${post.slug}`;
    link.className = 'group block py-4';

    const title = document.createElement('span');
    title.className = 'block text-ink underline-offset-4 group-hover:underline';
    title.textContent = post.data.title;

    const description = document.createElement('span');
    description.className = 'mt-1 block text-sm text-muted';
    description.textContent = post.data.description;

    link.append(title, description);
    return link;
  }

  function render(query: string) {
    if (!input || !results) return;

    results.replaceChildren();
    const q = query.trim().toLowerCase();

    if (q.length < 2) {
      if (hint) hint.hidden = false;
      return;
    }

    if (hint) hint.hidden = true;

    const matches = posts.filter(post =>
      post.data.title.toLowerCase().includes(q) ||
      post.data.description.toLowerCase().includes(q) ||
      post.data.tags.some(tag => tag.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'py-4 text-sm text-muted';
      empty.textContent = 'No se encontraron resultados.';
      results.append(empty);
      return;
    }

    matches.forEach(post => results.append(makeRow(post)));
  }

  input?.addEventListener('input', () => render(input.value));
</script>
