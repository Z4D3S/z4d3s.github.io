--- import { getCollection } from 'astro:content'; import BlogPost from '@/layouts/BlogPost.astro'; export async function getStaticPaths() { const posts = (await getCollection('blog')).filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md')); return posts.map(post => ({ params: { slug: post.slug }, props: { post }, })); } const { post } = Astro.props; const { Content } = await post.render(); --- <BlogPost post={post}> <Content /> </BlogPost> 