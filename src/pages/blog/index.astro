---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import TagCloud from '@/components/TagCloud.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'))
  .filter(post => post.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap(post => post.data.tags))];
---

<BaseLayout title="Blog - NightOps" description="Todos los artículos de ciberseguridad">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="cyber-heading mb-8">Todos los Artículos</h1>
    
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="grid md:grid-cols-2 gap-6">
          {posts.map(post => (
            <PostCard 
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              href={`/blog/${post.slug}`}
              tags={post.data.tags}
            />
          ))}
        </div>
      </div>
      
      <aside class="space-y-6">
        <TagCloud tags={allTags} />
      </aside>
    </div>
  </section>
</BaseLayout>
