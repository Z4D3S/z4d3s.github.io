---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { getCollection } from 'astro:content';
import { isVisiblePost, isChallenge, sortByDateDesc } from '@/utils/blog';

const posts = (await getCollection('blog'))
  .filter(isVisiblePost)
  .filter(post => !isChallenge(post))
  .sort(sortByDateDesc);
---

<BaseLayout title="Artículos - z4d3s" description="Todos los artículos">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <header class="mb-10">
      <p class="font-mono text-xs text-muted"><span class="text-accent">$</span> ls ~/artículos</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink">Artículos</h1>
      <p class="mt-2 text-muted">Análisis, notas e investigación.</p>
    </header>

    <ArticleList posts={posts} />

    <div class="mt-10 border-t border-line pt-6">
      <a href="/challenges" class="font-mono text-xs text-muted transition-colors hover:text-ink">
        Retos CTF &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
