---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'))
  .filter(post => post.data.draft !== true);

const tagCounts = posts.reduce((acc, post) => {
  post.data.tags.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const tags = Object.entries(tagCounts).sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Etiquetas - z4d3s" description="Todas las etiquetas">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <header class="mb-10">
      <p class="font-mono text-xs text-muted"><span class="text-accent">$</span> ls ~/etiquetas</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink">Etiquetas</h1>
      <p class="mt-2 text-muted">{tags.length} temas</p>
    </header>

    <ul class="grid gap-x-10 sm:grid-cols-2">
      {tags.map(([tag, count]) => (
        <li class="flex items-baseline justify-between border-b border-line py-3">
          <a href={`/tags/${tag}`} class="text-ink underline decoration-muted/40 underline-offset-4 hover:decoration-ink">
            #{tag}
          </a>
          <span class="font-mono text-[12px] tabular-nums text-muted">{count}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
