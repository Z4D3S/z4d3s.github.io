---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleList from '@/components/ArticleList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'));
  const tags = [...new Set(posts.flatMap(post => post.data.tags))];
  return tags.map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;

const posts = (await getCollection('blog'))
  .filter(post => !post.id.startsWith('.obsidian') && !post.id.startsWith('templates/') && !post.id.startsWith('Templates/') && post.id.endsWith('.md'))
  .filter(post => post.data.tags.includes(tag) && post.data.draft !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`#${tag} - z4d3s`} description={`Artículos etiquetados con ${tag}`}>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <a href="/tags" class="text-sm text-muted transition-colors hover:text-ink">
      &larr; Etiquetas
    </a>

    <header class="mb-10 mt-6">
      <p class="font-mono text-xs text-muted"><span class="text-accent">$</span> grep -r "#{tag}"</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink">#{tag}</h1>
      <p class="mt-2 text-muted">
        {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}
      </p>
    </header>

    <ArticleList posts={posts} />

    {posts.length === 0 && (
      <p class="text-muted">Aún no hay artículos.</p>
    )}
  </section>
</BaseLayout>
