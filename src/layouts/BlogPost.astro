---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CodeEnhancer from '@/components/CodeEnhancer.astro';
import '@/styles/global.css';
import { readingTime } from '@/utils/readingTime';
import { categories, difficultyLabels } from '@/config/theme';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, category, difficulty } = post.data;
const rt = readingTime(post.body || '');
const categoryLabel = categories.find(c => c.id === category)?.label || category;
const difficultyLabel = difficultyLabels[difficulty];
const formattedDate = pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdated = updatedDate?.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <BaseHead title={title} description={description} image={heroImage} type="article" />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1 page-enter">
      <article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
        <a href="/blog" class="text-sm text-muted transition-colors hover:text-ink">
          &larr; Artículos
        </a>

        <header class="mt-6 border-b border-line pb-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-accent">/ {categoryLabel}</p>
          <h1 class="mt-3 text-4xl font-semibold leading-[1.1] text-ink sm:text-5xl">{title}</h1>

          {description && <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>}

          <div class="mt-6 flex flex-wrap items-center gap-x-2 font-mono text-[12px] tracking-wide text-muted">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            <span aria-hidden="true">&middot;</span>
            <span>{rt} min de lectura</span>
            <span aria-hidden="true">&middot;</span>
            <span class="uppercase">{difficultyLabel}</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>Actualizado el {formattedUpdated}</span>
              </>
            )}
          </div>
        </header>

        {heroImage && (
          <div class="my-10 overflow-hidden rounded-lg border border-line">
            <img src={heroImage} alt={title} class="h-auto w-full" />
          </div>
        )}

        <div class="prose mt-10 max-w-[68ch]">
          <slot />
        </div>

        <CodeEnhancer />

  <script define:vars={{ slug: post.slug }}>
    const root = document.documentElement;
    function motionDisabled() {
      return (
        root.classList.contains('motion-off') ||
        (!root.classList.contains('motion-on') &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches)
      );
    }

    if (!motionDisabled()) {
      const shell = document.createElement('div');
      shell.className = 'post-shell';
      shell.setAttribute('aria-hidden', 'true');
      shell.innerHTML = `
        <div class="post-shell__window">
          <div class="post-shell__titlebar">
            <span class="post-shell__dot post-shell__dot--red"></span>
            <span class="post-shell__dot post-shell__dot--yellow"></span>
            <span class="post-shell__dot post-shell__dot--green"></span>
            <span class="post-shell__title">bash</span>
          </div>
          <div class="post-shell__body">
            <p class="post-shell__prompt">
              <span class="post-shell__user">z4des@blog</span><span class="post-shell__path">:~$</span>
              <span data-cmd></span><span class="post-shell__caret">_</span>
            </p>
            <p class="post-shell__out" data-delay="1">
              <span class="post-shell__ok">[ ok ]</span> artículo cargado
            </p>
            <p class="post-shell__out" data-delay="2">
              <span class="post-shell__ok">[ ok ]</span> markdown renderizado
            </p>
          </div>
        </div>
      `;
      document.body.append(shell);

      const command = `cat ${slug}.md`;
      const commandEl = shell.querySelector('[data-cmd]');
      let index = 0;
      const typer = window.setInterval(() => {
        index += 1;
        if (commandEl) commandEl.textContent = command.slice(0, index);
        if (index >= command.length) window.clearInterval(typer);
      }, 22);

      let active = true;
      const cleanup = () => {
        if (!active) return;
        active = false;
        shell.remove();
      };

      const close = () => {
        shell.classList.add('is-closing');
        shell.addEventListener('transitionend', cleanup, { once: true });
        window.setTimeout(cleanup, 600);
      };

      window.setTimeout(close, 2000);
    }
  </script>

        {tags.length > 0 && (
          <footer class="mt-14 border-t border-line pt-6">
            <ul class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-[12px]">
              {tags.map(tag => (
                <li>
                  <a href={`/tags/${tag}`} class="text-muted underline-offset-4 transition-colors hover:text-ink hover:underline">
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          </footer>
        )}
      </article>
    </main>
    <Footer />
  </body>
</html>
