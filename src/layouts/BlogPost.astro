---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags, author, difficulty } = post.data;

const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const locale = 'es-ES';

const formattedDate = pubDate.toLocaleDateString(locale, dateOptions);
const formattedUpdated = updatedDate?.toLocaleDateString(locale, dateOptions);

const difficultyLabels = { easy: 'Easy', medium: 'Medium', hard: 'Hard', info: 'Info' };
const difficultyColors = { 
  easy: 'bg-green-500/20 border-green-500/50 text-green-400', 
  medium: 'bg-yellow-500/20 border-yellow-500/50 text-yellow-400',
  hard: 'bg-red-500/20 border-red-500/50 text-red-400',
  info: 'bg-blue-500/20 border-blue-500/50 text-blue-400'
};
const difficultyColor = difficultyColors[difficulty || 'medium'];
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <BaseHead title={title} description={description} image={heroImage} type="article" />
  </head>
  <body class="bg-cyber-black text-gray-300 min-h-screen flex flex-col binary-bg-dark">
    <Header />
    <main class="flex-1 pt-16">
      <article class="max-w-4xl mx-auto px-4 py-12">
        {heroImage && (
          <div class="mb-8 rounded-lg overflow-hidden border border-cyber-border">
            <img src={heroImage} alt={title} class="w-full h-64 object-cover" />
          </div>
        )}
        
        <header class="mb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class={`px-2 py-0.5 rounded text-xs font-mono uppercase border ${difficultyColor}`}>{difficultyLabels[difficulty || 'medium']}</span>
            {tags.map(tag => (
              <a href={`/tags/${tag}`} class="cyber-tag">#{tag}</a>
            ))}
          </div>
          
          <h1 class="text-4xl font-bold text-white mb-4">{title}</h1>
          
          <div class="flex items-center gap-4 text-sm text-gray-400">
            <span>Por {author}</span>
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            {updatedDate && <span class="text-cyber-yellow">({formattedUpdated})</span>}
          </div>
        </header>
        
        <div class="prose prose-cyber prose-invert max-w-none">
          <slot />
        </div>
        
        <footer class="mt-12 pt-8 border-t border-cyber-border">
          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <a href={`/tags/${tag}`} class="cyber-tag">#{tag}</a>
            ))}
          </div>
        </footer>
      </article>
    </main>
    <Footer />
  </body>
</html>
