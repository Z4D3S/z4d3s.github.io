---
import MotionToggle from './MotionToggle.astro';
import { siteConfig } from '../config/theme';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-3xl flex-col gap-3 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <p>&copy; {year} {siteConfig.title}</p>
      <span class="text-muted/40" aria-hidden="true">/</span>
      <MotionToggle />
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href="/blog" class="transition-colors hover:text-ink">Artículos</a>
      <a href="/challenges" class="transition-colors hover:text-ink">Retos</a>
      <a href="/tags" class="transition-colors hover:text-ink">Etiquetas</a>
      <a href="/rss.xml" class="transition-colors hover:text-ink">RSS</a>
      <span class="font-mono text-[11px] uppercase tracking-wider text-accent" aria-hidden="true">EOF</span>
    </div>
  </div>
</footer>
