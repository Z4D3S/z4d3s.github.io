---
import { siteConfig } from '../config/theme';
---

<footer id="main-footer" class="border-t border-cyber-border bg-cyber-dark mt-16">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <img src="/images/logo.png" alt={siteConfig.title} class="h-10 w-auto mb-3" />
        <p class="mt-3 text-gray-500 text-sm font-mono">
          &gt; {siteConfig.description}
        </p>
        <p class="mt-2 text-gray-600 text-xs font-mono">
          $ whoami<br/>
          &gt; {siteConfig.author}
        </p>
      </div>
      
      <div>
        <h4 class="text-gray-400 font-mono text-sm mb-3">// NAV</h4>
        <ul class="space-y-1 text-sm font-mono">
          <li><a href="/blog" class="text-cyber-accent hover:underline">/blog</a></li>
          <li><a href="/search" class="text-cyber-accent hover:underline">/search</a></li>
          <li><a href="/resources" class="text-cyber-accent hover:underline">/resources</a></li>
          <li><a href="/rss.xml" class="text-cyber-accent hover:underline">/rss</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-cyber-border mt-6 pt-4 text-center">
      <p class="text-gray-600 text-xs font-mono">
        <span class="text-cyber-accent">$</span> cat footer.txt<br/>
        &copy; {new Date().getFullYear()} {siteConfig.title} - All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style is:global>
  html.light #main-footer {
    @apply bg-gray-100 border-gray-200;
  }
</style>
