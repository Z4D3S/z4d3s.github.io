---
import foxArt from '../assets/fox-ascii.txt?raw';

const lines = foxArt.replace(/\r/g, '').split('\n');
---

<div class="ascii-fox" aria-hidden="true">
  <div class="ascii-fox__screen">
    <pre class="ascii-fox__art">{lines.map((line, i) => (
      <span class="ascii-fox__line" style={`--i:${i}`}>{line || ' '}</span>
    ))}</pre>
  </div>
</div>
