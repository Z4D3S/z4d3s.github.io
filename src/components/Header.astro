---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../config/theme';

const navItems = [
  { href: '/blog', label: 'Artículos' },
  { href: '/challenges', label: 'Retos' },
  { href: '/tags', label: 'Etiquetas', compact: true },
  { href: '/about', label: 'Sobre mí', compact: true },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <nav class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight text-ink">
      {siteConfig.title}<span class="cursor-blink ml-0.5 font-mono font-normal text-accent" aria-hidden="true">_</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-6">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors hover:text-ink',
            item.compact && 'hidden sm:block',
            path === item.href
              ? 'text-ink underline decoration-accent decoration-2 underline-offset-8'
              : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}

      <ThemeToggle />

      <a
        href="/search"
        aria-label="Buscar"
        class="text-muted transition-colors hover:text-ink"
      >
        <Icon name="search" class="h-4 w-4" />
      </a>
    </div>
  </nav>
</header>
