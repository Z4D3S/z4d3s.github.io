---
import { getLangFromUrl, useTranslations } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div id="search" class="relative">
  <div class="relative">
    <input 
      type="text" 
      id="search-input"
      placeholder={t('search.placeholder')}
      class="w-full px-4 py-3 bg-cyber-gray border border-cyber-border rounded-lg 
             text-gray-300 placeholder-gray-500 focus:outline-none 
             focus:border-cyber-green transition-colors font-mono text-sm"
    />
    <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
  
  <div id="search-results" class="hidden absolute top-full left-0 right-0 mt-2 bg-cyber-gray border border-cyber-border rounded-lg shadow-xl z-50 max-h-80 overflow-y-auto">
  </div>
</div>

<script>
  import { getLangFromUrl } from '../utils/i18n';
  
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results');
  const lang = getLangFromUrl(new URL(window.location.href));
  
  let posts: Array<{slug: string; data: {title: string; description: string}}> = [];
  
  async function loadPosts() {
    try {
      const response = await fetch(`/${lang}/search.json`);
      posts = await response.json();
    } catch (e) {
      console.log('Search data not available');
    }
  }
  
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    
    if (query.length < 2) {
      searchResults?.classList.add('hidden');
      return;
    }
    
    const results = posts.filter(post => 
      post.data.title.toLowerCase().includes(query) ||
      post.data.description.toLowerCase().includes(query)
    ).slice(0, 10);
    
    if (results.length > 0) {
      searchResults?.classList.remove('hidden');
      searchResults.innerHTML = results.map(post => `
        <a href="/${lang}/blog/${post.slug}" class="block p-4 hover:bg-cyber-border transition-colors border-b border-cyber-border last:border-0">
          <h4 class="text-white font-semibold text-sm">${post.data.title}</h4>
          <p class="text-gray-400 text-xs mt-1 line-clamp-1">${post.data.description}</p>
        </a>
      `).join('');
    } else {
      searchResults?.classList.add('hidden');
    }
  });
  
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#search')) {
      searchResults?.classList.add('hidden');
    }
  });
  
  loadPosts();
</script>
