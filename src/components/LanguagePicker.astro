---
interface Props {
  currentLang?: string;
}

const { currentLang = 'es' } = Astro.props;

const languages = [
  { code: 'es', label: 'Español', href: '/' },
  { code: 'en', label: 'English', href: '/en' },
  { code: 'pt', label: 'Português', href: '/pt' },
];
---

<div class="relative group">
  <button class="flex items-center gap-2 px-3 py-2 rounded-md hover:bg-cyber-gray transition-colors font-mono text-sm">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="uppercase">{currentLang}</span>
  </button>
  
  <div class="absolute top-full right-0 mt-2 py-2 bg-cyber-gray border border-cyber-border rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 min-w-[140px] lang-dropdown">
    {languages.map(lang => (
      <a 
        href={lang.href} 
        class={`lang-option block px-4 py-2 text-sm hover:bg-cyber-border transition-colors ${currentLang === lang.code ? 'text-cyber-green' : ''}`}
      >
        {lang.label}
      </a>
    ))}
  </div>
</div>

<style is:global>
  html.light .lang-dropdown {
    @apply bg-white border-gray-200;
  }
  
  html.light .lang-option {
    @apply text-gray-700 hover:bg-gray-100;
  }
</style>
